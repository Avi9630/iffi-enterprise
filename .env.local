TZ=Asia/Kolkata
DOTENV_CONFIG_QUIET=true
# ── Database ─────────────────────────────────────────────────
# PostgreSQL (default)
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# MySQL         → also change prisma/schema.prisma provider to "mysql"
DATABASE_URL="mysql://root@localhost:3306/iffi_festival_api_v2"

# SQLite        → also change prisma/schema.prisma provider to "sqlite"
# DATABASE_URL="file:./dev.db"

# MongoDB       → also change prisma/schema.prisma provider to "mongodb"
# DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/mydb"

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated allowed origins (leave empty to allow all in dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

