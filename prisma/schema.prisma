generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model alumnis {
  id                  Int       @id @default(autoincrement())
  full_name           String?   @db.VarChar(255)
  mobile              String?   @db.VarChar(50)
  email               String?   @db.VarChar(255)
  age                 String?   @db.VarChar(50)
  gender              String?   @db.VarChar(50)
  category_id         Int?
  address             String?   @db.VarChar(255)
  current_designation String?   @db.LongText
  cmot_edition        Int?
  cv                  String?   @db.Text
  showreels           String?   @db.Text
  additional_info     String?   @db.Text
  created_at          DateTime  @default(now()) @db.Timestamp(0)
  updated_at          DateTime? @db.Timestamp(0)
}

model assign_to_jury {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    Int?
  cmot_id    Int?
  asigned_by Int?
  feedback   String?   @db.Text
  rating     Int?
  created_at DateTime  @default(now()) @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model cinemai {
  id                       Int       @id @default(autoincrement())
  payload                  String?   @db.LongText
  created_at               DateTime? @default(now()) @db.DateTime(0)
  updated_at               DateTime? @default(now()) @db.DateTime(0)
  step                     Int?
  client_id                Int?
  status                   Int?      @default(1) @db.TinyInt
  submission_date_and_time DateTime? @db.DateTime(0)
}

model cities {
  id            Int    @id @default(autoincrement())
  city          String @db.VarChar(255)
  state_id      Int?
  state_id_back Int?

  @@index([state_id], map: "state_id")
}

model clients {
  id                        BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  type_id                   BigInt?     @db.UnsignedBigInt
  website_type              Int?        @db.TinyInt
  name                      String?     @db.VarChar(50)
  first_name                String?     @db.VarChar(256)
  last_name                 String?     @db.VarChar(256)
  email                     String?     @db.VarChar(50)
  mobile                    String?     @db.VarChar(14)
  username                  String?     @db.VarChar(20)
  password                  String      @db.VarChar(255)
  status                    Int         @default(1) @db.TinyInt
  isblocked                 Int         @default(0) @db.TinyInt
  token                     String?     @db.VarChar(255)
  active                    Int         @default(1) @db.TinyInt
  activate_token            String?     @db.VarChar(256)
  activate_token_expires_at DateTime?   @db.Timestamp(0)
  activated_date            DateTime?   @db.Date
  email_verified_at         DateTime?   @db.Timestamp(0)
  created_at                DateTime    @default(now()) @db.Timestamp(0)
  updated_at                DateTime?   @db.Timestamp(0)
  ott_forms                 ott_forms[]
  payments                  payments[]
}

model cmot_categories {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  name              String              @db.VarChar(255)
  type              String              @db.VarChar(255)
  specialization    Int                 @db.TinyInt
  created_at        DateTime            @default(now()) @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  cmot_juri_details cmot_juri_details[]
  cmots             cmots[]
}

model cmot_juri_details {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  level           Int?             @db.TinyInt
  category_id     BigInt?          @db.UnsignedBigInt
  user_id         BigInt?          @db.UnsignedBigInt
  created_at      DateTime         @default(now()) @db.Timestamp(0)
  updated_at      DateTime?        @db.Timestamp(0)
  cmot_categories cmot_categories? @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "cmot_juri_details_category_id_foreign")
  users           users?           @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "cmot_juri_details_user_id_foreign")

  @@index([category_id], map: "cmot_juri_details_category_id_foreign")
  @@index([user_id], map: "cmot_juri_details_user_id_foreign")
}

model cmot_jury_assigns {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       Int?
  cmot_id       Int?
  assigned_by   Int?
  score1        Int?
  score2        Int?
  score3        Int?
  score4        Int?
  overall_score Int?
  total_score   Int?
  feedback      String?   @db.Text
  level         Int       @default(0) @db.TinyInt
  active        Int       @default(1) @db.TinyInt
  status        Int       @default(1) @db.TinyInt
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
}

model cmot_participants {
  id                  Int      @id @default(autoincrement())
  full_name           String?  @db.VarChar(255)
  age                 Int?
  email               String?  @db.VarChar(255)
  mobile              String?  @db.VarChar(22)
  gender              String?  @db.VarChar(10)
  cmot_category_id    Int?
  current_designation String   @default("CMOT Participant") @db.VarChar(50)
  cmot_edition        Int?
  resume              String?  @db.Text
  works               String?  @db.Text
  created_at          DateTime @default(now()) @db.Timestamp(0)
  updated_at          DateTime @default(now()) @db.Timestamp(0)
}

model cmot_scores {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  cmot_id    BigInt    @db.UnsignedBigInt
  score      Int       @db.UnsignedTinyInt
  given_by   BigInt    @db.UnsignedBigInt
  created_at DateTime  @default(now()) @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  cmots      cmots     @relation(fields: [cmot_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cmot_scores_cmot_id_foreign")
  users      users     @relation(fields: [given_by], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cmot_scores_given_by_foreign")

  @@index([cmot_id], map: "cmot_scores_cmot_id_index")
  @@index([given_by], map: "cmot_scores_given_by_index")
}

model cmot_specializations {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model cmot_statuses {
  id                                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  status                                Int       @db.TinyInt
  created_by                            BigInt    @db.UnsignedBigInt
  updated_by                            BigInt    @db.UnsignedBigInt
  created_at                            DateTime  @default(now()) @db.Timestamp(0)
  updated_at                            DateTime? @db.Timestamp(0)
  users_cmot_statuses_created_byTousers users     @relation("cmot_statuses_created_byTousers", fields: [created_by], references: [id], onUpdate: Restrict, map: "cmot_statuses_created_by_foreign")
  users_cmot_statuses_updated_byTousers users     @relation("cmot_statuses_updated_byTousers", fields: [updated_by], references: [id], onUpdate: Restrict, map: "cmot_statuses_updated_by_foreign")

  @@index([created_by], map: "cmot_statuses_created_by_foreign")
  @@index([updated_by], map: "cmot_statuses_updated_by_foreign")
}

model cmots {
  id                                    BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  step                                  Int?             @db.TinyInt
  stage                                 String?          @db.VarChar(255)
  client_id                             Int?
  name                                  String?          @db.VarChar(50)
  dob                                   DateTime?        @db.Date
  age                                   String?          @db.VarChar(100)
  gender                                Int?
  other_gender                          String?          @db.VarChar(255)
  contact_number                        String?          @db.VarChar(20)
  email                                 String?          @db.VarChar(50)
  bio                                   String?          @db.Text
  reason_to_join                        String?          @db.Text
  alternate_number                      String?          @db.VarChar(20)
  website_link                          String?          @db.VarChar(255)
  twitter_account_link                  String?          @db.VarChar(255)
  instagram_account_link                String?          @db.VarChar(255)
  facebook_account_link                 String?          @db.VarChar(255)
  linkedin_account_link                 String?          @db.VarChar(255)
  how_you_find                          String?          @db.Text
  permanent_address                     String?          @db.Text
  permanent_city                        String?          @db.VarChar(255)
  permanent_state                       String?          @db.VarChar(255)
  permanent_country_id                  BigInt?          @db.UnsignedBigInt
  address_confirmation                  Int?             @db.TinyInt
  residence_address                     String?          @db.Text
  residence_city                        String?          @db.VarChar(255)
  residence_state                       String?          @db.VarChar(255)
  residence_country_id                  BigInt?          @db.UnsignedBigInt
  first_govt_id_number                  String?          @db.VarChar(255)
  second_govt_id_number                 String?          @db.VarChar(255)
  category_id                           BigInt?          @db.UnsignedBigInt
  link_of_film                          String?          @db.Text
  link_film_password                    String?          @db.VarChar(256)
  project_title                         String?          @db.Text
  film_duration                         String?          @db.VarChar(255)
  awards_recognition                    String?          @db.VarChar(255)
  filmography_url                       String?          @db.VarChar(255)
  declare_right_to_short_film           Int?             @db.TinyInt
  declare_have_all_necessary_permission Int?             @db.TinyInt
  declare_non_commercial_publicity      Int?             @db.TinyInt
  declare_for_false_informtion          Int?             @db.TinyInt
  declare_for_correct_informtion        Int?             @db.TinyInt
  confirm                               Int?             @db.TinyInt
  status                                Int              @default(1) @db.TinyInt
  created_at                            DateTime         @default(now()) @db.Timestamp(0)
  active                                Int              @default(1) @db.TinyInt
  declaration_tv_reserve                Int?             @db.TinyInt
  other_specialization                  String?          @db.VarChar(255)
  specialization_id                     BigInt?          @db.UnsignedBigInt
  state_of_origin_id                    BigInt?          @db.UnsignedBigInt
  state_of_origin                       String?          @db.VarChar(255)
  project_completion_date               DateTime?        @db.Date
  cmot_applicant                        String           @db.VarChar(255)
  highest_qualification_id              Int              @db.TinyInt
  degree                                String           @db.VarChar(255)
  year_of_degree                        String           @db.VarChar(255)
  specialization                        String?          @db.VarChar(255)
  scale                                 Int?             @db.TinyInt
  bio2                                  String?          @db.Text
  declaration_assigned_department       Int?             @db.TinyInt
  country_code                          String?          @db.VarChar(255)
  alternate_country_code                String?          @db.VarChar(255)
  year                                  Int              @default(2025)
  submission_date_and_time              DateTime?        @db.Timestamp(0)
  updated_at                            DateTime?        @db.Timestamp(0)
  cmot_scores                           cmot_scores[]
  cmot_categories                       cmot_categories? @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "cmots_category_id_foreign")

  @@index([category_id], map: "cmots_category_id_foreign")
}

model countries {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  country_name String?   @db.VarChar(255)
  country_code String?   @db.VarChar(255)
  num_code     String?   @db.VarChar(255)
  nationality  String?   @db.VarChar(255)
  created_at   DateTime  @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
}

model credentials {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  type       String    @db.VarChar(5)
  key        String    @db.VarChar(50)
  data       String    @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

