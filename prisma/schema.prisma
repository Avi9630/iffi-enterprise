generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model clients {
  id                BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  client_type_id    BigInt?        @db.UnsignedBigInt
  first_name        String         @db.VarChar(100)
  last_name         String?        @db.VarChar(100)
  email             String         @unique @db.VarChar(150)
  mobile            String?        @unique @db.VarChar(15)
  profile_image     String?        @db.VarChar(255)
  status            clients_status @default(INACTIVE)
  email_verified_at DateTime?      @db.Timestamp(0)
  last_login_at     DateTime?      @db.Timestamp(0)
  password_hash     String         @db.VarChar(255)
  created_at        DateTime       @default(now()) @db.Timestamp(0)
  updated_at        DateTime?      @db.Timestamp(0)
  deleted_at        DateTime?      @db.Timestamp(0)
  client_types      client_types?  @relation(fields: [client_type_id], references: [id], onDelete: Cascade, map: "fk_client_type_id")

  @@index([email], map: "email")
  @@index([client_type_id], map: "fk_client_type_id")
}

model client_types {
  id         BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  name       String              @db.VarChar(155)
  status     client_types_status @default(ACTIVE)
  created_at DateTime            @default(now()) @db.Timestamp(0)
  updated_at DateTime?           @db.Timestamp(0)
  clients    clients[]
}

enum clients_status {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum client_types_status {
  ACTIVE
  INACTIVE
}
