  client_id   BigInt?         @unique(map: "client_id") @db.UnsignedBigInt
  type        otp_codes_type?
  target      String?         @db.VarChar(50)
  otp         Int?
  attempts    Int             @default(0)
  expires_at  DateTime?       @db.DateTime(0)
  verified_at DateTime?       @db.DateTime(0)
  ip_address  String?         @db.VarChar(50)
  status      Int             @default(2) @db.TinyInt
  created_at  DateTime        @default(now()) @db.Timestamp(0)
  updated_at  DateTime?       @db.Timestamp(0)
  clients     clients?        @relation(fields: [client_id], references: [id], onUpdate: SetNull, map: "otp_codes_ibfk_1")

  @@index([client_id], map: "client_id_2")
}

model states {
  id         Int    @id @default(autoincrement())
