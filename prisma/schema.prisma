generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model clients {
  id                BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  client_type_id    BigInt?        @db.UnsignedBigInt
  first_name        String         @db.VarChar(100)
  last_name         String?        @db.VarChar(100)
  email             String         @unique @db.VarChar(150)
  mobile            String?        @unique @db.VarChar(15)
  profile_image     String?        @db.VarChar(255)
  status            clients_status @default(INACTIVE)
  email_verified_at DateTime?      @db.Timestamp(0)
  last_login_at     DateTime?      @db.Timestamp(0)
  password_hash     String         @db.VarChar(255)
  token             String?        @db.Text
  activation_token  String?        @db.Text
  created_at        DateTime       @default(now()) @db.Timestamp(0)
  updated_at        DateTime?      @db.Timestamp(0)
  deleted_at        DateTime?      @db.Timestamp(0)
  client_types      client_types?  @relation(fields: [client_type_id], references: [id], onDelete: Cascade, map: "fk_client_type_id")
  otp_codes         otp_codes?

  @@index([email], map: "email")
  @@index([client_type_id], map: "fk_client_type_id")
}

model client_types {
  id         BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  name       String              @db.VarChar(155)
  status     client_types_status @default(ACTIVE)
  created_at DateTime            @default(now()) @db.Timestamp(0)
  updated_at DateTime?           @db.Timestamp(0)
  clients    clients[]
}

model otp_codes {
  id          BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt?          @unique(map: "user_id") @db.UnsignedBigInt
  client_id   BigInt?          @unique(map: "client_id") @db.UnsignedBigInt
  type        otp_codes_type?
  target      String?          @db.VarChar(50)
  otp         Int?
  attempts    Int              @default(0)
  expires_at  DateTime?        @db.DateTime(0)
  verified_at DateTime?        @db.DateTime(0)
  ip_address  String?          @db.VarChar(50)
  status      otp_codes_status @default(PENDING)
  created_at  DateTime         @default(now()) @db.Timestamp(0)
  updated_at  DateTime?        @db.Timestamp(0)
  clients     clients?         @relation(fields: [client_id], references: [id], onUpdate: SetNull, map: "otp_codes_ibfk_1")

  @@index([client_id], map: "client_id_2")
}

enum clients_status {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum client_types_status {
  ACTIVE
  INACTIVE
}

enum otp_codes_status {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

enum otp_codes_type {
  MOBILE
  EMAIL
}
