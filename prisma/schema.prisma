  language_id                               BigInt?                    @db.UnsignedBigInt
  other_language_name                       String?                    @db.VarChar(256)
  whether_subtitle_english                  Int?                       @db.TinyInt
  dcp                                       Int?                       @db.TinyInt
  dci_compliant_jpeg_2000                   Int?                       @db.TinyInt
  subtitle_to_be_burned_in_picture          Int?                       @db.TinyInt
  dcp_should_cru_hard_disk                  Int?                       @db.TinyInt
  hard_disk_format_ext2_ext3                Int?                       @db.TinyInt
