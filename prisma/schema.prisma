generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model cities {
  id            Int    @id @default(autoincrement())
  city          String @db.VarChar(255)
  state_id      Int?
  state_id_back Int?

  @@index([state_id], map: "state_id")
}

model client_types {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(155)
  status     Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  clients    clients[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model clients {
  id                BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  client_type_id    BigInt?       @db.UnsignedBigInt
  first_name        String        @db.VarChar(100)
  last_name         String?       @db.VarChar(100)
  email             String        @unique @db.VarChar(150)
  mobile            String?       @unique @db.VarChar(15)
  profile_image     String?       @db.VarChar(255)
  status            Int           @default(2) @db.TinyInt
  email_verified_at DateTime?     @db.Timestamp(0)
  last_login_at     DateTime?     @db.Timestamp(0)
  password_hash     String        @db.VarChar(255)
  token             String?       @db.Text
  activation_token  String?       @db.Text
  created_at        DateTime      @default(now()) @db.Timestamp(0)
  updated_at        DateTime?     @db.Timestamp(0)
  deleted_at        DateTime?     @db.Timestamp(0)
  client_types      client_types? @relation(fields: [client_type_id], references: [id], onDelete: Cascade, map: "fk_client_type_id")
  otp_codes         otp_codes?

  @@index([email], map: "email")
  @@index([client_type_id], map: "fk_client_type_id")
}

model countries {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  country_name String?   @db.VarChar(255)
  country_code String?   @db.VarChar(255)
  num_code     String?   @db.VarChar(255)
  nationality  String?   @db.VarChar(255)
  created_at   DateTime  @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
}

model documents {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  context_id    BigInt    @db.UnsignedBigInt
  website_type  Int       @db.TinyInt
  document_type Int       @db.TinyInt
  doc_name      String    @db.VarChar(255)
  modified_name String    @db.VarChar(255)
  doc_path      String?   @db.Text
  created_by    String?   @db.VarChar(255)
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
}

model genres {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String?   @db.VarChar(255)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

